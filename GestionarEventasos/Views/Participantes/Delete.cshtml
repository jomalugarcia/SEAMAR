@model GestionarEventasos.Models.Participante
@{ ViewData["Title"] = "Eliminar Participante"; }

<div class="row justify-content-center grid-margin">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-body">
                <h4 class="card-title text-danger">
                    <i class="mdi mdi-alert-circle mr-2"></i>Confirmar Eliminación
                </h4>
                <hr />
                <p>Si quieres eliminar este participante??</p>
                <div class="bg-gray-dark rounded p-3 mb-3">
                    <p class="mb-1"><strong>Nombre:</strong> @Model.NombreCompleto</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                    <p class="mb-0"><strong>Inscripciones:</strong> @Model.Inscripciones.Count</p>
                </div>
                @if (Model.Inscripciones.Any())
                {
                    <div class="alert alert-warning">
                        <i class="mdi mdi-alert mr-2"></i>
                        Es que tene <strong>@Model.Inscripciones.Count</strong> inscripciónes.
                        Por lo que tambien se eliminarian.
                    </div>
                }
                <div class="d-flex mt-3">
                    <form asp-action="Delete" method="post" class="mr-2">
                        <input type="hidden" asp-for="IdParticipante" />
                        <button type="submit" class="btn btn-danger">
                            <i class="mdi mdi-trash-can mr-1"></i>Eliminar
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="mdi mdi-arrow-left mr-1"></i>Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
