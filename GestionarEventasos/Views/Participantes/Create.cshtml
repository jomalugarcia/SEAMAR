@model GestionarEventasos.Models.Participante
@{ ViewData["Title"] = "Nuevo Participante"; }

<div class="row justify-content-center grid-margin">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title"><i class="mdi mdi-account-plus mr-2"></i>Registrar Participante</h4>
                <hr />
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="NombreCompleto">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control" placeholder="" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Telefono">Teléfono <span class="text-muted">(opcional)</span></label>
                        <input asp-for="Telefono" class="form-control" placeholder="" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FechaRegistro">Fecha de Registro</label>
                        <input asp-for="FechaRegistro" class="form-control" type="date" />
                        <span asp-validation-for="FechaRegistro" class="text-danger small"></span>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success mr-2">
                            <i class="mdi mdi-check mr-1"></i>Registrar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="mdi mdi-arrow-left mr-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
