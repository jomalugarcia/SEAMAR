@model IEnumerable<GestionarEventasos.Models.Participante>
@{ ViewData["Title"] = "Participantes"; }

<div class="row grid-margin">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0"><i class="mdi mdi-account-group mr-2"></i>Gestión de Participantes</h4>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="mdi mdi-account-plus mr-1"></i>Nuevo Participante
                    </a>
                </div>

                <form method="get" class="row mb-3">
                    <div class="col-md-7">
                        <input type="text" name="buscar" class="form-control form-control-sm"
                               placeholder="Buscar por nombre o email..." value="@ViewBag.Buscar" />
                    </div>
                    <div class="col-md-5">
                        <button type="submit" class="btn btn-primary btn-sm mr-2">
                            <i class="mdi mdi-magnify mr-1"></i>Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                    </div>
                </form>

                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="mdi mdi-account-off" style="font-size:3rem;"></i>
                        <p class="mt-2">NNo hay participantes con ese nombre.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nombre Completo</th>
                                    <th>Email</th>
                                    <th>Teléfono</th>
                                    <th class="text-center">Fecha Registro</th>
                                    <th class="text-center">Inscripciones</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model)
                                {
                                    <tr>
                                        <td class="font-weight-medium">@p.NombreCompleto</td>
                                        <td class="text-muted">@p.Email</td>
                                        <td>@(p.Telefono ?? "—")</td>
                                        <td class="text-center">@p.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            <span class="badge badge-outline-info">@p.Inscripciones.Count</span>
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="Details" asp-route-id="@p.IdParticipante" class="btn btn-outline-info btn-sm" title="Ver"><i class="mdi mdi-eye"></i></a>
                                            <a asp-action="Edit" asp-route-id="@p.IdParticipante" class="btn btn-outline-warning btn-sm" title="Editar"><i class="mdi mdi-pencil"></i></a>
                                            <a asp-action="Delete" asp-route-id="@p.IdParticipante" class="btn btn-outline-danger btn-sm" title="Eliminar"><i class="mdi mdi-trash-can"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2">Total: @Model.Count() participante(s)</p>
                }
            </div>
        </div>
    </div>
</div>
