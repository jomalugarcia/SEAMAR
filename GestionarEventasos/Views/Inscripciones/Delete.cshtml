@model GestionarEventasos.Models.Inscripcione
@{ ViewData["Title"] = "Eliminar Inscripción"; }

<div class="row justify-content-center grid-margin">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-body">
                <h4 class="card-title text-danger">
                    <i class="mdi mdi-alert-circle mr-2"></i>Confirmar Eliminación
                </h4>
                <hr />
                <p>Realmente quieres eliminar esta inscripcion?</p>
                <div class="bg-gray-dark rounded p-3 mb-3">
                    <p class="mb-1"><strong>Evento:</strong> @Model.Evento?.Nombre</p>
                    <p class="mb-1"><strong>Participante:</strong> @Model.Participante?.NombreCompleto</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.Participante?.Email</p>
                    <p class="mb-1"><strong>Fecha:</strong> @Model.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-0"><strong>SeVino:</strong> @(Model.SeVino ? "Sí" : "No")</p>
                </div>
                <div class="d-flex mt-3">
                    <form asp-action="Delete" method="post" class="mr-2">
                        <input type="hidden" asp-for="IdInscripcion" />
                        <button type="submit" class="btn btn-danger">
                            <i class="mdi mdi-trash-can mr-1"></i>Eliminar
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="mdi mdi-arrow-left mr-1"></i>Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
