@model GestionarEventasos.Models.Inscripcione
@{ ViewData["Title"] = "Nueva Inscripción"; }

<div class="row justify-content-center grid-margin">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title"><i class="mdi mdi-clipboard-plus mr-2"></i>Nueva Inscripción</h4>
                <hr />
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="form-group">
                        <label>Evento</label>
                        <select asp-for="EventoId" class="form-control"
                                asp-items="@(ViewBag.EventoId as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                            <option value="">Seleccione un evento</option>
                        </select>
                        <span asp-validation-for="EventoId" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label>Participante</label>
                        <select asp-for="ParticipanteId" class="form-control"
                                asp-items="@(ViewBag.ParticipanteId as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                            <option value="">Seleccione un participante</option>
                        </select>
                        <span asp-validation-for="ParticipanteId" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FechaInscripcion">Fecha de Inscripción</label>
                        <input asp-for="FechaInscripcion" class="form-control" type="datetime-local" />
                    </div>
                    <div class="form-group">
                        <div class="form-check">
                            <input asp-for="SeVino" class="form-check-input" type="checkbox" />
                            <label asp-for="SeVino" class="form-check-label">Vino al eventaso? (SeVino)</label>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success mr-2">
                            <i class="mdi mdi-check mr-1"></i>Inscribir
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="mdi mdi-arrow-left mr-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
